# Internal recipe: the CI build supplies the already tested installation tree.
pkgname=sawfish-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Qt desktop client for Rostra'
arch=('x86_64' 'aarch64')
url='https://github.com/fig0ut/sawfish'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'fontconfig' 'freetype2' 'dbus' 'libglvnd'
         'libx11' 'libxcb' 'libxkbcommon-x11' 'xcb-util-cursor' 'xcb-util-image'
         'xcb-util-keysyms' 'xcb-util-renderutil' 'xcb-util-wm' 'xcb-util'
         'glib2' 'libdrm' 'mesa' 'zlib' 'zstd' 'openssl' 'krb5' 'ca-certificates' 'wayland')
provides=('sawfish')
conflicts=('sawfish')
options=('!strip' '!debug')

package() {
    cp -a "${SAWFISH_PACKAGE_ROOT:?Staged package root is required}/." "$pkgdir/"
}
